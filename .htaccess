<IfModule mod_rewrite.c>
  RewriteEngine On

  # non-www -> www
  RewriteCond %{HTTP_HOST} ^veridiareklam\.com\.tr$ [NC]
  RewriteRule ^(.*)$ https://www.veridiareklam.com.tr/$1 [R=301,L]

  # http -> https
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://www.veridiareklam.com.tr/$1 [R=301,L]

  # /index.html -> / (sadece dogrudan istekte; DirectoryIndex ic istegi haric)
  RewriteCond %{THE_REQUEST} \s/index\.html [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Legacy URL'ler
  RewriteRule ^blog/b2b-pazarlamada-donusum-hunisi\.html$ /blog/b2b-donusum-hunisi.html [R=301,L]
  RewriteRule ^asdfadsf\.html$ / [R=301,L]
  RewriteRule ^veridia-ajans\.html$ / [R=301,L]
  RewriteRule ^neler-yapiyoruz\.html$ /hizmetler/ [R=301,L]
  RewriteRule ^web-tasarim\.html$ /hizmetler/web-tasarim/ [R=301,L]
  RewriteRule ^seo-danismanligi\.html$ /hizmetler/seo-danismanligi/ [R=301,L]
  RewriteRule ^google-ads-yonetimi\.html$ /hizmetler/google-ads-yonetimi/ [R=301,L]
  RewriteRule ^sosyal-medya-yonetimi\.html$ /hizmetler/sosyal-medya-yonetimi/ [R=301,L]
  RewriteRule ^guzellik-klinik-dijital-pazarlama\.html$ /sektorler/guzellik-merkezleri-icin-dijital-pazarlama/ [R=301,L]
  RewriteRule ^guzellik-merkezleri-icin-dijital-pazarlama$ /sektorler/guzellik-merkezleri-icin-dijital-pazarlama/ [R=301,L]

  # .html'siz istekleri .html'li kanonik versiyona yonlendir
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ /$1.html [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Security headers.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://formspree.io https://www.google-analytics.com https://region1.google-analytics.com https://stats.g.doubleclick.net; form-action 'self' https://formspree.io https://wa.me; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"

  # Static asset caching.
  <FilesMatch "\.(?:css|js|woff2|png|svg|jpg|jpeg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?:html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
